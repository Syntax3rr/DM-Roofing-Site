---
/**
 * Mobile sticky action bar: a wide "Get a free estimate" button with a
 * small call button beside it, shown after the visitor scrolls past the
 * first screen. Body padding is toggled together with the bar so it
 * never covers page content.
 */
import { siteConfig } from '../../config/site';
import Icon from './Icon.astro';
---

<!-- Sentinel: while this (viewport-tall, zero-width) marker is on
     screen we're still in the first screenful, so the bar stays hidden. -->
<div data-scb-sentinel class="pointer-events-none absolute left-0 top-0 h-screen w-px" aria-hidden="true"></div>

<nav
  id="sticky-call-bar"
  aria-label="Quick contact"
  class="fixed inset-x-0 bottom-0 z-40 flex translate-y-full gap-2 border-t border-stone-200 bg-white p-2 transition-transform duration-300 lg:hidden"
>
  <a
    href="/quote/"
    class="btn btn-primary min-h-[48px] flex-1"
  >
    Get a free estimate
    <Icon name="arrow-right" class="h-5 w-5" />
  </a>
  <a
    href={siteConfig.phoneHref}
    class="btn btn-outline min-h-[48px] w-14 px-0"
    aria-label={`Call ${siteConfig.phone}`}
  >
    <Icon name="phone" class="h-5 w-5" />
  </a>
</nav>

<style is:global>
  /* Reserve space under the page content while the bar is shown. */
  @media (max-width: 1023px) {
    body.scb-visible {
      padding-bottom: 64px;
    }
  }
  body.scb-visible #sticky-call-bar {
    /* Tailwind v4's translate-y-full uses the `translate` property. */
    translate: 0 0;
  }
</style>

<script>
  const bar = document.getElementById('sticky-call-bar');
  const sentinel = document.querySelector('[data-scb-sentinel]');
  if (bar && sentinel && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(([entry]) => {
      document.body.classList.toggle('scb-visible', !entry.isIntersecting);
    });
    observer.observe(sentinel);
  }
</script>
