---
/**
 * Interior page header: breadcrumbs, H1, and an optional lead, on the
 * warm light surface with a maroon rule underneath.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from './Breadcrumbs.astro';

interface Props {
  title: string;
  lead?: string;
  crumbs: Crumb[];
}

const { title, lead, crumbs } = Astro.props;
---

<section class="border-b-4 border-dark bg-surface">
  <div class="mx-auto max-w-6xl px-4 pb-10 pt-8 sm:px-6 md:pb-14 lg:px-8">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-6 max-w-3xl font-heading text-4xl leading-tight text-dark md:text-5xl">
      {title}
    </h1>
    {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">{lead}</p>}
    <slot />
  </div>
</section>
