---
/**
 * Site footer. All company data comes from src/config/site.ts.
 */
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import { footerCompanyNav } from '../../config/nav';
import Logo from './Logo.astro';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);

const year = new Date().getFullYear();
const { serviceArea } = siteConfig;
---

<footer class="bg-dark-deep text-white/75">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-[1.3fr_1fr_1fr] lg:px-8">
    <div>
      <a href="/" aria-label={`${siteConfig.name}, home`}>
        <Logo onDark />
      </a>
      <p class="mt-5">
        <a href="/quote/" class="btn btn-primary-on-dark">
          Get a free estimate
        </a>
      </p>
      <p class="mt-4">
        <a href={siteConfig.phoneHref} class="font-semibold text-white hover:text-primary">{siteConfig.phone}</a>
      </p>
      <p class="mt-1">
        <a href={`mailto:${siteConfig.email}`} class="hover:text-white">{siteConfig.email}</a>
      </p>
      <p class="mt-4 text-sm">
        Serving the {serviceArea.region}.
        {siteConfig.availability}. {siteConfig.emergencyNote}
      </p>
    </div>

    <nav aria-label="Services">
      <h2 class="font-semibold text-white">Services</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          services.map((service) => (
            <li>
              <a href={`/services/#${service.id}`} class="hover:text-white">
                {service.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Company">
      <h2 class="font-semibold text-white">Company</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          footerCompanyNav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-white">{item.label}</a>
            </li>
          ))
        }
        <li>
          <a href={siteConfig.social.facebook} class="hover:text-white">Facebook</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-white/60 sm:px-6 lg:px-8">
      © {year} {siteConfig.name}
    </p>
  </div>
</footer>
