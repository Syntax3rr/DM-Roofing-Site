---
/**
 * Closing call-to-action band: points to the estimate form, with the
 * phone number as a secondary option.
 */
import { siteConfig } from '../../config/site';
import Button from '../common/Button.astro';

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = 'Ready for a price?',
  lead = "Send us a few details about your project and we'll come by with a free estimate. There's no obligation.",
} = Astro.props;
---

<section class="relative bg-dark text-white">
  <div class="absolute inset-x-0 top-0 h-2 bg-primary" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between md:py-16 lg:px-8">
    <div class="max-w-xl">
      <h2 class="font-heading text-3xl leading-tight md:text-4xl">{title}</h2>
      <p class="mt-3 text-lg leading-relaxed text-white/80">{lead}</p>
    </div>
    <div class="shrink-0">
      <Button href="/quote/" variant="primary-on-dark" size="lg">Get a free estimate</Button>
      <p class="mt-3 text-sm text-white/70">
        Urgent? Call <a href={siteConfig.phoneHref} class="font-semibold text-white hover:text-primary">{siteConfig.phone}</a>
      </p>
    </div>
  </div>
</section>
