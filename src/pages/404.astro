---
/**
 * Branded 404 with useful next steps.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import { siteConfig } from '../config/site';

const links = [
  { label: 'Our services', href: '/services/' },
  { label: 'About us', href: '/about/' },
  { label: 'Get a free estimate', href: '/quote/' },
];
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist or has moved."
  noindex
>
  <section class="bg-dark py-24 text-white md:py-32">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <p class="text-7xl font-bold text-primary md:text-8xl">404</p>
      <h1 class="mt-4 text-3xl font-bold leading-tight md:text-4xl">
        We couldn't find that page
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-stone-300">
        The page you're looking for doesn't exist or has moved. Try one of
        these instead:
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-sm border border-white/30 px-5 py-2.5 text-base font-semibold text-white transition-colors hover:border-primary hover:text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <Button href="/" variant="primary-on-dark" size="lg">Back to home</Button>
        <Button href={siteConfig.phoneHref} variant="outline-light" size="lg">
          <Icon name="phone" class="h-5 w-5" />
          {siteConfig.phone}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
