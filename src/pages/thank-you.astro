---
/**
 * Post-submission confirmation with a clear "what happens next" —
 * the conversion-experience detail most contractor sites skip.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import { siteConfig } from '../config/site';

const steps = [
  {
    icon: 'phone',
    title: 'We call you',
    text: 'We’ll get in touch by phone or email to ask a couple of questions.',
  },
  {
    icon: 'home',
    title: 'We come by',
    text: 'We pick a time that works for you and come have a look.',
  },
  {
    icon: 'file-text',
    title: 'You get a price',
    text: 'No charge for the estimate, and no pressure to go ahead.',
  },
];
---

<BaseLayout
  title="Thanks, we got your request"
  description="Your request has been received. Here's what happens next."
  noindex
>
  <section class="bg-dark py-20 text-white md:py-28">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white">
        <Icon name="check" class="h-8 w-8 text-dark" strokeWidth={3} />
      </span>
      <h1 class="mt-6 text-4xl font-bold leading-tight md:text-5xl">
        Thanks, we got it
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-stone-300">
        Here's what happens next.
      </p>
    </div>
  </section>

  <section class="bg-surface py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <ol class="grid gap-6 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="relative rounded-sm border border-stone-200 bg-white p-6 pt-8">
              <span
                class="absolute -top-4 left-6 flex h-9 w-9 items-center justify-center rounded-sm bg-dark text-lg font-bold text-white"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <Icon name={step.icon} class="h-6 w-6 text-primary-ink" />
              <h2 class="mt-3 text-lg font-bold text-dark">{step.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 rounded-sm border border-stone-200 bg-white p-6 text-center">
        <p class="text-xl font-bold text-dark">
          Need help right away?
        </p>
        <p class="mt-1 text-sm text-stone-600">
          For emergencies, call us directly.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-4">
          <Button href={siteConfig.phoneHref}>
            <Icon name="phone" class="h-5 w-5" />
            Call {siteConfig.phone}
          </Button>
          <Button href="/" variant="outline">Back to home</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
