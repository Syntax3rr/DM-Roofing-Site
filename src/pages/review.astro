---
/**
 * Review page. Sends customers to Google; Google's review form can't be
 * embedded, so this is a link. Linked from the testimonials section, and
 * a short address to text customers after a job.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import Button from '../components/common/Button.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Leave a Review"
  description={`Had work done by ${siteConfig.name}? Leave us a review on Google.`}
>
  <PageHero
    title="Leave a review"
    lead="Had work done by us? Tell us how it went."
    crumbs={[{ label: 'Leave a review' }]}
  />

  <section class="bg-surface py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="border-t-4 border-primary bg-white p-6 sm:p-8">
        <h2 class="text-xl font-bold text-dark">Review us on Google</h2>
        <p class="mt-2 text-stone-700">
          Google reviews are what people see when they look us up, so they help us the most.
        </p>
        <div class="mt-5">
          <Button href={siteConfig.googleReviewUrl} size="lg">Write a Google review</Button>
        </div>
      </div>
      <p class="mt-6 text-sm text-stone-600">
        No Google account? Email your review to
        <a href={`mailto:${siteConfig.email}`} class="font-semibold text-primary-ink hover:underline">{siteConfig.email}</a>
        or leave one on our
        <a href={siteConfig.social.facebook} class="font-semibold text-primary-ink hover:underline">Facebook page</a>.
      </p>
    </div>
  </section>
</BaseLayout>
