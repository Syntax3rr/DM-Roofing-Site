---
/**
 * Shown after the review form is sent.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Thanks for your review"
  description="Your review has been sent."
  noindex
>
  <section class="bg-dark py-20 text-white md:py-28">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white">
        <Icon name="check" class="h-8 w-8 text-dark" strokeWidth={3} />
      </span>
      <h1 class="mt-6 text-4xl font-bold leading-tight md:text-5xl">Thanks for the review</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-stone-300">
        We read every one. We appreciate you taking the time.
      </p>
      <p class="mx-auto mt-4 max-w-xl text-stone-300">
        If you have a Google account, posting the same review there helps other homeowners find us.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href={siteConfig.googleReviewUrl} variant="primary-on-dark">Review us on Google</Button>
        <Button href="/" variant="outline-light">Back to home</Button>
      </div>
    </div>
  </section>
</BaseLayout>
